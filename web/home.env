# Home lab deployment (CT 9250 roadmap-web, 192.168.5.254).
#
#   docker compose --env-file home.env up --build -d
#
# Everything from the public internet with no proxy. Sign-in uses the TEST
# identity provider in tools/devidp (run it on the same host, port 8090), so
# the real SAML path is exercised without Azure.
#
# Committed to git, so NO SECRETS here.

# --- how people reach it ------------------------------------------------------
RMS_PUBLIC_URL=https://192.168.5.254
RMS_PORT=443
RMS_HTTP_PORT=80
RMS_CERTS_DIR=./certs
RMS_TLS_CERT_NAME=tls.crt
RMS_TLS_KEY_NAME=tls.key
RMS_TLS_HOSTNAME=roadmap-web

# --- sign-in -------------------------------------------------------------------
RMS_AUTH_MODE=saml
RMS_SAML_METADATA_URL=http://192.168.5.254:8090/metadata
RMS_SAML_METADATA_FILE=
RMS_SAML_TENANT_ID=
RMS_SAML_ALLOWED_GROUPS=
RMS_ADMIN_EMAILS=alice@example.test
RMS_OUTBOUND_PROXY=
RMS_DEV_LOGIN_ACKNOWLEDGE=
RMS_LOCAL_ADMIN=on

# --- where things come from -------------------------------------------------------
# Empty means "none": no registry prefix (Docker Hub) and no proxy. The lines
# must stay, set to nothing - removing them brings back the company defaults.
IMAGE_REGISTRY=
GOPROXY=https://proxy.golang.org,direct
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
