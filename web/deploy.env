# Deployment settings.
#
#   docker compose --env-file deploy.env up --build -d
#
# Edit RMS_PUBLIC_URL, RMS_SAML_METADATA_URL and RMS_ADMIN_EMAILS before the
# first start. Everything else can stay as it is.
#
# Committed to git, so NO SECRETS here (there are none to give: the database
# password is generated on the first start, and SAML needs no secret).

# --- how people reach it ------------------------------------------------------
# The address people open. Azure sends sign-ins back to <this>/saml/acs, so it
# must be exactly what the browser shows - set it before the first start.
RMS_PUBLIC_URL=https://roadmap.example.com
# Host ports: HTTPS on 443, and 80 redirecting to it. Change only when
# something else on the host holds them (the address then carries the port).
RMS_PORT=443
RMS_HTTP_PORT=80
# Certificate folder: tls-init puts a self-signed pair here if it is empty.
# Replace tls.crt / tls.key with a real certificate (PEM) when you have one.
RMS_CERTS_DIR=./certs
RMS_TLS_CERT_NAME=tls.crt
RMS_TLS_KEY_NAME=tls.key
# Extra names for the self-signed certificate, comma-separated.
RMS_TLS_HOSTNAME=

# --- sign-in (Microsoft Entra ID, SAML) -----------------------------------------
RMS_AUTH_MODE=saml
# The "App Federation Metadata Url" from the Enterprise Application's Single
# sign-on page (https://login.microsoftonline.com/<tenant>/federationmetadata/
# 2007-06/federationmetadata.xml?appid=<app id>). Not a secret.
RMS_SAML_METADATA_URL=
# Or a downloaded copy of that XML, placed in ./saml/ (e.g. /saml/federation.xml).
RMS_SAML_METADATA_FILE=
# Optional: refuse sign-ins from any other tenant (the tenant id GUID).
RMS_SAML_TENANT_ID=
# Optional: only members of these Azure group object ids may sign in. Usually
# left empty and controlled in Azure ("Assignment required" + Users and groups).
RMS_SAML_ALLOWED_GROUPS=
# Who administers RoadMap Studio (comma-separated email addresses).
RMS_ADMIN_EMAILS=
# The proxy the app uses to read the metadata URL. Empty = direct.
RMS_OUTBOUND_PROXY=
# Test sign-in without Azure. Leave empty on a real deployment.
RMS_DEV_LOGIN_ACKNOWLEDGE=
# The local administrator: user "admin", created at the first start with the
# password "admin" - sign in at /auth/local and CHANGE IT. Also the way in
# before single sign-on is configured. "off" refuses local sign-in.
RMS_LOCAL_ADMIN=on

# --- where things come from -------------------------------------------------------
# Public locations. A site with its own Docker Hub mirror sets the prefix
# (e.g. IMAGE_REGISTRY=mirror.example.com/), its own Go module proxy, and the
# outbound proxy the build should use. Empty means none.
IMAGE_REGISTRY=
GOPROXY=https://proxy.golang.org,direct
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
