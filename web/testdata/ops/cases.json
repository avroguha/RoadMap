{
  "_about": "Shared by ops_test.go (server) and test/ops.test.js (browser): both must produce the same result for every case. shape = lanes[subs(items)] | markers. checks: [id, field, value]; id '' is the roadmap itself, field 'view.x' a view setting; value null with field '' means the entity must not exist.",
  "doc": {
    "id": "rm", "name": "R", "start": "2026-01-01", "end": "2026-12-31",
    "view": { "theme": "office", "zoom": "fit" },
    "markers": [{ "id": "m1", "name": "UAT", "date": "2026-06-01" }],
    "lanes": [
      { "id": "L1", "name": "Lane 1", "subs": [
        { "id": "S1", "name": "Sub 1", "items": [{ "id": "i1", "name": "A" }, { "id": "i2", "name": "B" }, { "id": "i3", "name": "C" }] },
        { "id": "S2", "name": "Sub 2", "items": [] }
      ] },
      { "id": "L2", "name": "Lane 2", "subs": [{ "id": "S3", "name": "", "items": [{ "id": "i4", "name": "D" }] }] }
    ]
  },
  "cases": [
    { "name": "root fields and view; structure and unknown keys are ignored",
      "ops": [{ "t": "root", "f": { "name": "New", "view.theme": "dark", "lanes": "x", "bogus": 1 } }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1",
      "checks": [["", "name", "New"], ["", "view.theme", "dark"], ["", "view.zoom", "fit"], ["", "bogus", null]] },
    { "name": "set changes fields but never identity or structure",
      "ops": [{ "t": "set", "id": "i1", "f": { "name": "A2", "progress": 40, "id": "zz", "items": [] } }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1",
      "checks": [["i1", "name", "A2"], ["i1", "progress", 40], ["i1", "id", "i1"]] },
    { "name": "set on an entity that does not exist is skipped",
      "ops": [{ "t": "set", "id": "nope", "f": { "name": "x" } }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [] },
    { "name": "add after a sibling; data cannot choose the id or children",
      "ops": [{ "t": "add", "id": "i9", "kind": "item", "parent": "S1", "after": "i1", "data": { "name": "N", "id": "other", "items": [1] } }],
      "shape": "L1[S1(i1,i9,i2,i3),S2()],L2[S3(i4)]|m1",
      "checks": [["i9", "name", "N"], ["i9", "id", "i9"], ["i9", "items", null]] },
    { "name": "add with after empty goes first",
      "ops": [{ "t": "add", "id": "i9", "kind": "item", "parent": "S1", "after": "", "data": { "name": "N" } }],
      "shape": "L1[S1(i9,i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [] },
    { "name": "add after a sibling that has gone appends",
      "ops": [{ "t": "add", "id": "i9", "kind": "item", "parent": "S1", "after": "gone", "data": {} }],
      "shape": "L1[S1(i1,i2,i3,i9),S2()],L2[S3(i4)]|m1", "checks": [] },
    { "name": "add under a parent that does not exist is skipped",
      "ops": [{ "t": "add", "id": "i9", "kind": "item", "parent": "nope", "after": "", "data": {} }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [["i9", "", null]] },
    { "name": "add under the wrong kind of parent is skipped",
      "ops": [{ "t": "add", "id": "i9", "kind": "item", "parent": "L1", "after": "", "data": {} },
              { "t": "add", "id": "L9", "kind": "lane", "parent": "S1", "after": "", "data": {} }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [["i9", "", null], ["L9", "", null]] },
    { "name": "add of an id that already exists changes nothing",
      "ops": [{ "t": "add", "id": "i1", "kind": "item", "parent": "S2", "after": "", "data": { "name": "Z" } }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [["i1", "name", "A"]] },
    { "name": "a new lane starts with no subs whatever data says",
      "ops": [{ "t": "add", "id": "L3", "kind": "lane", "parent": "", "after": "L2", "data": { "name": "L3", "subs": [{ "id": "x" }] } }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)],L3[]|m1", "checks": [["L3", "name", "L3"], ["x", "", null]] },
    { "name": "move across subs",
      "ops": [{ "t": "move", "id": "i1", "parent": "S2", "after": "" }],
      "shape": "L1[S1(i2,i3),S2(i1)],L2[S3(i4)]|m1", "checks": [] },
    { "name": "move into another lane's sub",
      "ops": [{ "t": "move", "id": "i4", "parent": "S1", "after": "i3" }],
      "shape": "L1[S1(i1,i2,i3,i4),S2()],L2[S3()]|m1", "checks": [] },
    { "name": "move to a parent that does not exist is skipped",
      "ops": [{ "t": "move", "id": "i1", "parent": "nope", "after": "" }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [] },
    { "name": "move after itself is skipped",
      "ops": [{ "t": "move", "id": "i2", "parent": "S1", "after": "i2" }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m1", "checks": [] },
    { "name": "reorder lanes and keep their contents",
      "ops": [{ "t": "move", "id": "L2", "parent": "", "after": "" }],
      "shape": "L2[S3(i4)],L1[S1(i1,i2,i3),S2()]|m1", "checks": [] },
    { "name": "delete takes the children; later edits to them are skipped",
      "ops": [{ "t": "del", "id": "S1" }, { "t": "set", "id": "i1", "f": { "name": "late" } }, { "t": "move", "id": "i2", "parent": "S2", "after": "" }],
      "shape": "L1[S2()],L2[S3(i4)]|m1", "checks": [["i1", "", null], ["i2", "", null]] },
    { "name": "delete twice is harmless, and a deleted id can be added again",
      "ops": [{ "t": "del", "id": "i2" }, { "t": "del", "id": "i2" }, { "t": "add", "id": "i2", "kind": "item", "parent": "S2", "after": "", "data": { "name": "B again" } }],
      "shape": "L1[S1(i1,i3),S2(i2)],L2[S3(i4)]|m1", "checks": [["i2", "name", "B again"]] },
    { "name": "markers add, move and delete",
      "ops": [{ "t": "add", "id": "m2", "kind": "marker", "parent": "", "after": "m1", "data": { "name": "Prod" } },
              { "t": "move", "id": "m2", "parent": "", "after": "" },
              { "t": "add", "id": "m3", "kind": "marker", "parent": "", "after": "m1", "data": {} },
              { "t": "del", "id": "m1" }],
      "shape": "L1[S1(i1,i2,i3),S2()],L2[S3(i4)]|m2,m3", "checks": [["m2", "name", "Prod"]] }
  ]
}
